rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('monthlyBudget' in data) || data.monthlyBudget == null || (data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000));
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             (data.type == 'INCOME' || data.type == 'EXPENSE') &&
             data.amount is number && data.amount > 0 && data.amount <= 1000000000 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500)) &&
             (!('imageBase64' in data) || data.imageBase64 == null || (data.imageBase64 is string && data.imageBase64.size() <= 350000)) &&
             data.date is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'monthlyBudget', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'monthlyBudget', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /transactions/{transactionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll(['userId', 'type', 'amount', 'category', 'date', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'type', 'amount', 'category', 'note', 'imageBase64', 'date', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidTransaction(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTransaction(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'note', 'imageBase64', 'date', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
